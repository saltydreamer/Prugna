{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 150,
    "trailingComma": "all",
    "htmlWhitespaceSensitivity": "ignore",
    "singleAttributePerLine": false,
    "overrides": [
        {
            "files": ["*.json", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
