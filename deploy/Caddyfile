{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

# SERVER_NAME is the public domain (automatic HTTPS via Let's Encrypt),
# or ":80" to serve plain HTTP (local tests).
{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Vite assets have hashed file names: cache them forever.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
